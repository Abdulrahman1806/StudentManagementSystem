@model StudentManagementSystem.Models.Student

<h1>Add Student</h1>

<form method="post">

    <div>
        <label>Name</label>
        <input asp-for="Name" />
    </div>

    <div>
        <label>Age</label>
        <input asp-for="Age" />
    </div>

    <div>
        <label>Department</label>
        <input asp-for="Department" />
    </div>

    <button type="submit">Add Student</button>

</form>