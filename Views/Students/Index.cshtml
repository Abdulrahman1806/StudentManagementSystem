@model List<StudentManagementSystem.Models.Student>

<h1>Students</h1>

<a asp-controller="Students"
   asp-action="Create"
   class="btn btn-primary mb-3">
    Add Student
</a>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Age</th>
            <th>Department</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var student in Model)
        {
            <tr>
                <td>@student.Id</td>
                <td>@student.Name</td>
                <td>@student.Age</td>
                <td>@student.Department</td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@student.Id"
                       class="btn btn-warning">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@student.Id"
                       class="btn btn-danger">
                        Delete
                    </a>
                </td>
            </tr>
        }

    </tbody>

</table>