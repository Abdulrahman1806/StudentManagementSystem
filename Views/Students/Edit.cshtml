@model StudentManagementSystem.Models.Student

<h2>Edit Student</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <div>
        <label>Name</label>
        <input asp-for="Name" />
    </div>

    <div>
        <label>Age</label>
        <input asp-for="Age" />
    </div>

    <div>
        <label>Department</label>
        <input asp-for="Department" />
    </div>

    <button type="submit">Save Changes</button>

</form>